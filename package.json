{
  "name": "react-quiz-component",
  "version": "2.1.0",
  "description": "Customizable React quiz component for JSON-powered quizzes with scoring, timers, single or multiple choice answers, images, markdown, and callbacks.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "pnpm build && pnpm --filter @react-quiz/docs dev",
    "build:docs": "pnpm build && pnpm --filter @react-quiz/docs build",
    "build": "rollup -c",
    "lint": "oxlint src --fix --react-plugin --jsx-a11y-plugin --import-plugin",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:package": "node test/package.test.mjs",
    "test:react": "node test/react-compat.test.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck:docs": "pnpm --filter @react-quiz/docs typecheck",
    "test:docs": "pnpm --filter @react-quiz/docs test"
  },
  "keywords": [
    "react",
    "reactjs",
    "react-component",
    "react-quiz-component",
    "react-quiz",
    "quiz",
    "quiz-component",
    "quiz-app",
    "json-quiz",
    "online-quiz",
    "interactive-quiz",
    "multiple-choice",
    "single-choice",
    "questionnaire",
    "scoring",
    "timer",
    "markdown",
    "image-quiz",
    "education",
    "e-learning",
    "assessment",
    "typescript",
    "react-typescript",
    "react-library"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/plugin-transform-object-rest-spread": "8.0.1",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@testing-library/react": "16.3.3",
    "@types/sanitize-html": "2.16.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "4.65.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "author": "WK Wong <wkwdev@proton.me>",
  "homepage": "https://github.com/wingkwong/react-quiz-component",
  "repository": {
    "type": "git",
    "url": "https://github.com/wingkwong/react-quiz-component.git"
  },
  "dependencies": {
    "nanoid": "6.0.2",
    "sanitize-html": "2.18.1",
    "snarkdown": "2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.16.1"
}